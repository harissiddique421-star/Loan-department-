SECRET_KEY=generate-a-long-random-secret
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-unique-strong-password
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret-never-expose-in-browser
SUPABASE_BUCKET=tooba-private-documents
UPLOAD_FOLDER=/tmp/tooba_uploads# Optional security settings
# RESTRICT_STAFF_ACCESS=1      # staff see only applications they created or are assigned to
# LOGIN_MAX_FAILS=5            # wrong passwords allowed per username before temporary lock
# LOGIN_LOCK_MINUTES=15
# SECURE_COOKIES=1             # HTTPS-only cookies (default on for any non-SQLite deployment)
# Google Drive archive (Admin → Backup & Recovery). The OAuth client lets the Admin connect the
# Google account that owns the archive; the token itself is stored encrypted in the database.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_ARCHIVE_PARENT_ID=     # optional: folder (or Shared Drive folder) to create the archive in
# ARCHIVE_TIME_BUDGET=45        # seconds per cron run
# ARCHIVE_INLINE=1              # archive right after each save
